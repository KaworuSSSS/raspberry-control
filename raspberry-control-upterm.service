
[Unit]
Description=Raspberry Control Upterm Remote Access
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=raspberry-control
Group=raspberry-control
WorkingDirectory=/var/lib/raspberry-control
EnvironmentFile=/etc/raspberry-control/upterm.env
ExecStart=/usr/local/bin/upterm host --authorized-keys /etc/raspberry-control/authorized_keys
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/raspberry-control

[Install]
WantedBy=multi-user.target
