
[Unit]
Description=Raspberry Control Upterm Remote Terminal
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=raspberry-control
Group=raspberry-control
WorkingDirectory=/var/lib/raspberry-control
Environment=HOME=/var/lib/raspberry-control
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStart=/usr/local/bin/upterm host --server wss://uptermd.upterm.dev --known-hosts /etc/raspberry-control/known_hosts --authorized-keys /etc/raspberry-control/authorized_keys --accept -- bash

Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/raspberry-control

[Install]
WantedBy=multi-user.target
