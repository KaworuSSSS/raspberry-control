
[Unit]
Description=Raspberry Control Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=raspberry-control
Group=raspberry-control
WorkingDirectory=/opt/raspberry-control
EnvironmentFile=/etc/raspberry-control/bot.env
ExecStart=/opt/raspberry-control/venv/bin/python /opt/raspberry-control/bot.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/raspberry-control

[Install]
WantedBy=multi-user.target
